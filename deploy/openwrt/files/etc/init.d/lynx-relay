#!/bin/sh /etc/rc.common
# TeamLynx field relay on OpenWrt (procd). Settings: /etc/config/lynx (uci), see docs/field/net-network.md.

USE_PROCD=1
START=95
STOP=10

start_service() {
	config_load lynx
	local enabled role priority squad port tick_ms log log_hz python pythonpath
	config_get_bool enabled relay enabled 1
	[ "$enabled" -eq 1 ] || return 0
	config_get role relay role primary
	config_get priority relay priority 0
	config_get squad relay squad LYNX
	config_get port relay port 8765
	config_get tick_ms relay tick_ms 25
	config_get log relay log ''
	config_get log_hz relay log_hz 5
	config_get python relay python /usr/bin/python3
	config_get pythonpath relay pythonpath /opt/lynx

	procd_open_instance relay
	procd_set_param command "$python" -m lynx.field relay --role "$role" --priority "$priority" \
		--squad "$squad" --port "$port" --tick-ms "$tick_ms" --stats-interval 30
	if [ -n "$log" ]; then
		mkdir -p "$log"
		procd_append_param command --log "$log" --log-hz "$log_hz" --log-gz
	fi
	procd_set_param env PYTHONPATH="$pythonpath" PYTHONUNBUFFERED=1
	# respawn forever, 2 s apart
	procd_set_param respawn 3600 2 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger lynx
}
